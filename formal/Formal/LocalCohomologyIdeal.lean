/-
G2 (PLAN.md Track G): the unique-factorization step of Theorem 4.15 in thesis v2.

Over a field `K`, the principal ideal generated by a product of nonzero linear forms in
`MvPolynomial σ K` determines the multiset of those forms up to associates (nonzero scalars).
In the thesis this is the step "the local equivariant cohomology ideal (α₁ ⋯ αₙ) of a fixed
point determines the weights, with multiplicities, hence the weight matroid".
-/
import Mathlib

open MvPolynomial

namespace MatroidToric

variable {σ K : Type*} [Field K]

/-- A polynomial of total degree one over a field is irreducible. This is Mathlib's
`MvPolynomial.irreducible_of_totalDegree_eq_one`, whose content hypothesis holds over a field. -/
theorem irreducible_of_linear {p : MvPolynomial σ K} (hp : p.totalDegree = 1) : Irreducible p := by
  refine MvPolynomial.irreducible_of_totalDegree_eq_one hp fun x hx => ?_
  rcases eq_or_ne x 0 with rfl | hx0
  · -- if 0 divides every coefficient then p = 0, contradicting totalDegree p = 1
    have : p = 0 := by
      ext i
      simpa using hx i
    simp [this] at hp
  · exact hx0.isUnit

/-- Associated multisets have associated products. -/
theorem Multiset.prod_associated_of_rel {M : Type*} [CommMonoid M] :
    ∀ {s t : Multiset M}, Multiset.Rel Associated s t → Associated s.prod t.prod := by
  intro s
  induction s using Multiset.induction_on with
  | empty =>
    intro t h
    rw [Multiset.rel_zero_left.mp h]
  | cons a s ih =>
    intro t h
    obtain ⟨b, t', hab, hst, rfl⟩ := Multiset.rel_cons_left.mp h
    simpa [Multiset.prod_cons] using hab.mul_mul (ih hst)

/-- **G2.** For multisets of linear forms over a field, the principal ideals generated by their
products coincide iff the multisets agree up to associates, i.e. up to order and nonzero
scalar factors. -/
theorem span_prod_eq_iff (α β : Multiset (MvPolynomial σ K))
    (hα : ∀ p ∈ α, p.totalDegree = 1) (hβ : ∀ p ∈ β, p.totalDegree = 1) :
    Ideal.span {α.prod} = Ideal.span {β.prod} ↔ Multiset.Rel Associated α β := by
  rw [Ideal.span_singleton_eq_span_singleton]
  constructor
  · exact UniqueFactorizationMonoid.factors_unique
      (fun p hp => irreducible_of_linear (hα p hp)) (fun p hp => irreducible_of_linear (hβ p hp))
  · exact Multiset.prod_associated_of_rel

end MatroidToric
